{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endonend.example/schemas/manifest.schema.json",
  "title": "endonend manifest",
  "description": "Machine-readable schema for the manifest format defined in KB/0003-manifest.md. This is the shared source of truth both the Go and Kotlin Multiplatform validators compile or test against, per KB/0002-architecture.md's 'kept honest by a shared schema' approach.",
  "type": "object",
  "required": ["manifestVersion", "identity", "refresh", "history", "signature"],
  "properties": {
    "manifestVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "identity": { "$ref": "#/$defs/identity" },
    "refresh": { "$ref": "#/$defs/refresh" },
    "label": { "$ref": "#/$defs/label" },
    "contributions": { "type": "array", "items": { "$ref": "#/$defs/contribution" } },
    "beacon": { "$ref": "#/$defs/beacon" },
    "merch": { "type": "array", "items": { "$ref": "#/$defs/merchLink" } },
    "history": { "$ref": "#/$defs/historyRef" },
    "presentation": { "$ref": "#/$defs/presentation" },
    "catalog": { "type": "array", "items": { "$ref": "#/$defs/album" } },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "if": {
    "properties": { "identity": { "properties": { "type": { "const": "artist" } } } },
    "required": ["identity"]
  },
  "then": { "required": ["catalog"] },
  "$defs": {
    "urlString": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "identity": {
      "type": "object",
      "required": ["type", "name", "url", "publicKey", "contactEmail"],
      "properties": {
        "type": { "enum": ["artist", "label"] },
        "name": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/urlString" },
        "publicKey": { "type": "string", "pattern": "^ed25519:" },
        "contactEmail": { "type": "string", "format": "email" }
      }
    },
    "refresh": {
      "type": "object",
      "required": ["ttlSeconds"],
      "properties": {
        "ttlSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "split": {
      "type": "object",
      "required": ["artist", "label"],
      "properties": {
        "artist": { "type": "number", "minimum": 0, "maximum": 100 },
        "label": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "label": {
      "type": "object",
      "properties": {
        "affiliatedLabel": { "$ref": "#/$defs/urlString" },
        "split": { "$ref": "#/$defs/split" },
        "roster": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["artistManifestUrl", "split"],
            "properties": {
              "artistManifestUrl": { "$ref": "#/$defs/urlString" },
              "split": { "$ref": "#/$defs/split" }
            }
          }
        }
      }
    },
    "contribution": {
      "type": "object",
      "required": ["manifestUrl", "albumId", "albumVersion", "role", "percentage"],
      "properties": {
        "manifestUrl": { "$ref": "#/$defs/urlString" },
        "albumId": { "type": "string", "minLength": 1 },
        "albumVersion": { "type": "integer", "minimum": 1 },
        "role": { "type": "string", "minLength": 1 },
        "percentage": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "beacon": {
      "type": "object",
      "properties": {
        "url": { "$ref": "#/$defs/urlString" }
      }
    },
    "merchLink": {
      "type": "object",
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/urlString" }
      }
    },
    "historyRef": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "$ref": "#/$defs/urlString" },
        "headHash": { "type": "string" }
      }
    },
    "presentation": {
      "type": "object",
      "properties": {
        "colors": {
          "type": "object",
          "properties": {
            "primary": { "type": "string" },
            "heroBackground": { "type": "string" },
            "background": { "type": "string" },
            "text": { "type": "string" }
          }
        },
        "links": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/urlString" }
        },
        "footer": { "type": "string" }
      }
    },
    "images": {
      "type": "object",
      "required": ["front", "insert"],
      "properties": {
        "front": { "$ref": "#/$defs/urlString" },
        "back": { "$ref": "#/$defs/urlString" },
        "insert": { "type": "array", "items": { "$ref": "#/$defs/urlString" } }
      }
    },
    "albumSplitEntry": {
      "type": "object",
      "required": ["manifestUrl", "role", "percentage"],
      "properties": {
        "manifestUrl": { "$ref": "#/$defs/urlString" },
        "role": { "type": "string", "minLength": 1 },
        "percentage": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "purchaseLink": {
      "type": "object",
      "required": ["format", "url"],
      "properties": {
        "format": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/urlString" }
      }
    },
    "creditsParagraphSegment": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "url": { "$ref": "#/$defs/urlString" }
      }
    },
    "creditsParagraph": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/creditsParagraphSegment" } }
      ]
    },
    "credits": {
      "type": "object",
      "properties": {
        "paragraphs": { "type": "array", "items": { "$ref": "#/$defs/creditsParagraph" } }
      }
    },
    "track": {
      "type": "object",
      "required": ["trackId", "number", "name", "duration", "file"],
      "properties": {
        "trackId": { "type": "string", "minLength": 1 },
        "side": { "type": "string" },
        "number": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "duration": { "type": "string" },
        "file": { "$ref": "#/$defs/urlString" },
        "lyrics": { "type": ["string", "null"] }
      }
    },
    "album": {
      "type": "object",
      "required": ["albumId", "albumVersion", "albumName", "releaseDate", "images", "tracks"],
      "properties": {
        "albumId": { "type": "string", "minLength": 1 },
        "albumVersion": { "type": "integer", "minimum": 1 },
        "albumName": { "type": "string", "minLength": 1 },
        "pageTitle": { "type": "string" },
        "releaseDate": { "type": "string", "format": "date" },
        "images": { "$ref": "#/$defs/images" },
        "downloadZip": { "$ref": "#/$defs/urlString" },
        "credits": { "$ref": "#/$defs/credits" },
        "splits": { "type": "array", "items": { "$ref": "#/$defs/albumSplitEntry" } },
        "purchaseLinks": { "type": "array", "items": { "$ref": "#/$defs/purchaseLink" } },
        "presentation": { "$ref": "#/$defs/presentation" },
        "tracks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/track" } }
      }
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "value": { "type": "string", "minLength": 1 }
      }
    }
  }
}
