#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"
source scripts/git-hooks/lib.sh

modules=()
while IFS= read -r module; do
    modules+=("$module")
done < <(find_go_modules)

[ "${#modules[@]}" -eq 0 ] && exit 0

require_golangci_lint pre-push
check_go_modules pre-push "${modules[@]}"
