#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"
source scripts/git-hooks/lib.sh

staged_go_files="$(git diff --cached --name-only --diff-filter=ACMR -- '*.go')"
[ -z "$staged_go_files" ] && exit 0

raw_modules=()
while IFS= read -r file; do
    module="$(module_for_file "$file")"
    [ -n "$module" ] && raw_modules+=("$module")
done <<< "$staged_go_files"

[ "${#raw_modules[@]}" -eq 0 ] && exit 0

modules=()
while IFS= read -r module; do
    modules+=("$module")
done < <(printf '%s\n' "${raw_modules[@]}" | sort -u)

require_golangci_lint pre-commit
check_go_modules pre-commit "${modules[@]}"
