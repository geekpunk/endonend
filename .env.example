# Copy to .env and fill in before running `docker compose up`.
# .env itself is gitignored; never commit real secrets here.

# Shared secret gating the admin console's GraphQL mutations
# (POST /v1/admin/graphql with header X-Admin-Token). Required; the admin
# API refuses every request if this is empty.
ADMIN_TOKEN=change-me

# Postgres credentials for the backend's own database. Defaults below are
# fine for local/self-run use; change them for anything more exposed.
POSTGRES_USER=endonend
POSTGRES_PASSWORD=endonend
POSTGRES_DB=endonend

# How often the crawler checks for identities whose refresh TTL has
# elapsed. This is a check interval, not the per-artist crawl cadence
# itself, which is TTL-driven per KB/0002-architecture.md.
CRAWL_CHECK_INTERVAL=60s

# Ports exposed on the host.
BACKEND_PORT=8080
WEB_PORT=3000

# Baked into the web app at build time: where the browser sends GraphQL
# requests. Must be reachable from wherever the browser runs, not just
# from inside the compose network. Change this if BACKEND_PORT changes or
# you're deploying somewhere other than localhost.
PUBLIC_API_URL=http://localhost:8080
